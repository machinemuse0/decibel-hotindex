#!/usr/bin/env bash
set -u

output=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f)
      shift 2
      ;;
    -o)
      output="${2:-}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "gtime compatibility wrapper: missing command" >&2
  exit 125
fi

"$@"
status=$?

if [[ -n "$output" ]]; then
  printf '0.00 0.00\n' >"$output" 2>/dev/null || true
fi

exit "$status"
